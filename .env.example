# 复制为 .env 后生效：cp .env.example .env
#
# 所有变量都有默认值，空文件即可启动。仅在需要覆盖时取消注释。

# 宿主机数据目录（绝对路径）。默认：$HOME/echuan-data
# ECHUAN_DATA_DIR=/Users/you/echuan-data

# 宿主机监听端口（只绑定 127.0.0.1）。默认：8720
# ECHUAN_PORT=8720

# 容器运行用户。默认：10001
# Linux 宿主机若数据目录属主不是 10001，请二选一：
#   1) sudo chown -R 10001:10001 "$ECHUAN_DATA_DIR"
#   2) 在此设置 ECHUAN_UID/ECHUAN_GID 为数据目录属主
# ECHUAN_UID=10001
# ECHUAN_GID=10001

# 日志级别覆盖（debug/info/warn/error）。留空则使用 configs/echuan.container.toml
# ECHUAN_LOG_LEVEL=

# 容器名 / 镜像名（一般无需修改；验收脚本依赖 echuan）
# ECHUAN_CONTAINER_NAME=echuan
# ECHUAN_IMAGE=echuan:local

# compose 项目名（可选）。设置后 scripts/restore.sh 会执行 docker compose -p <名称>；
# 不设置时沿用 docker compose 默认推导（compose 文件所在目录名）。
# 机器上跑多个 echuan 部署、或从仓库以外的目录调用脚本时建议显式设置。
# COMPOSE_PROJECT_NAME=echuan

# 时区
# TZ=Asia/Shanghai

# 构建期代理。默认清空 = 直连，会覆盖 Docker Desktop 的全局代理。
# 如果构建需要的网络必须走代理，在这里填写（macOS 用 host.docker.internal）：
# DOCKER_BUILD_HTTP_PROXY=http://host.docker.internal:7890
# DOCKER_BUILD_HTTPS_PROXY=http://host.docker.internal:7890
# DOCKER_BUILD_ALL_PROXY=socks5://host.docker.internal:7890

# 构建期 Go module 代理（goproxy.cn 在国内更快；go.sum 仍会校验完整性）
# DOCKER_BUILD_GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
