        { "material_id": "m_orphan_brief", "title": "孤儿简报", "kind": "context", "role": "output", "source_material_id": "m_never_seen" },
        { "material_id": "m_design_v1", "title": "技术方案 v1", "kind": "design", "role": "output" }
