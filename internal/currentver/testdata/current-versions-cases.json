      "refs": [
        { "material_id": "m_dup", "title": "设计正文（补挂为输入附件）", "kind": "design", "role": "input" },
        { "material_id": "m_dup", "title": "设计正文 v1", "kind": "design", "role": "output" },
        { "material_id": "m_dup_next", "title": "设计正文 v2", "kind": "design", "role": "output" }
