        { "material_id": "m_out_design_v2", "title": "技术方案 v2", "kind": "design", "role": "output" },
        { "material_id": "m_out_report", "title": "交付报告", "kind": "report", "role": "output" },
        { "material_id": "m_out_report_brief", "title": "交付报告简报", "kind": "context", "role": "output", "source_material_id": "m_out_report" }
