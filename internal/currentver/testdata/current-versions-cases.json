{
  "cases": [
    {
      "name": "R-a role=input 永不隐藏（同 kind 有更新版本时仍保留原位置）",
      "refs": [
        { "material_id": "m_req_in", "title": "需求正文（作为输入附件）", "kind": "requirement", "role": "input" },
        { "material_id": "m_req_v1", "title": "需求 v1", "kind": "requirement", "role": "output" },
        { "material_id": "m_req_v2", "title": "需求 v2", "kind": "requirement", "role": "output" }
      ],
      "want_material_ids": ["m_req_in", "m_req_v2"]
    },
    {
      "name": "R-d 同 kind 两条 output 只留最后一条",
      "refs": [
        { "material_id": "m_plan_v1", "title": "实施方案 v1", "kind": "plan", "role": "output" },
        { "material_id": "m_plan_v2", "title": "实施方案 v2", "kind": "plan", "role": "output" }
      ],
      "want_material_ids": ["m_plan_v2"]
    },
    {
      "name": "R-e 简报跟随被丢弃的 source 一同隐藏",
      "refs": [
        { "material_id": "m_report_v1", "title": "交付报告 v1", "kind": "report", "role": "output" },
        { "material_id": "m_report_v1_brief", "title": "简报 v1", "kind": "context", "role": "output", "source_material_id": "m_report_v1" },
