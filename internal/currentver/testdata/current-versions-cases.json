      "refs": [
        { "material_id": "m_req_v1", "title": "需求 v1", "kind": "requirement", "role": "output" },
        { "material_id": "m_req_v2", "title": "需求 v2", "kind": "requirement", "role": "output" },
        { "material_id": "m_brief_outer", "title": "外层简报", "kind": "context", "role": "output", "source_material_id": "m_brief_inner" },
        { "material_id": "m_brief_inner", "title": "内层简报", "kind": "context", "role": "output", "source_material_id": "m_req_v1" }
      ],
      "want_material_ids": ["m_req_v2"]
    },
    {
      "name": "R-b context 与 other 按条显示，不参与去重",
      "refs": [
        { "material_id": "m_ctx_a", "title": "上下文 A", "kind": "context", "role": "output" },
        { "material_id": "m_ctx_b", "title": "上下文 B", "kind": "context", "role": "output" },
        { "material_id": "m_other_a", "title": "其它 A", "kind": "other", "role": "output" },
        { "material_id": "m_other_b", "title": "其它 B", "kind": "other", "role": "output" },
        { "material_id": "m_report_v1", "title": "交付报告 v1", "kind": "report", "role": "output" },
        { "material_id": "m_report_v2", "title": "交付报告 v2", "kind": "report", "role": "output" }
      ],
      "want_material_ids": ["m_ctx_a", "m_ctx_b", "m_other_a", "m_other_b", "m_report_v2"]
